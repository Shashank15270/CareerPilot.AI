# Copy to .env and fill in.

# ---- Job search (REQUIRED) ----
# JSearch is the only job source. Without this key the app returns zero jobs.
# Get it at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# (subscribe to the API, then copy the X-RapidAPI-Key value)
RAPIDAPI_KEY=

# ---- LLM (REQUIRED for resume review / career coach / mock interview) ----
GROQ_API_KEY=

# ---- Auth ----
# Change this in production. Used to sign JWTs.
SECRET_KEY=change-me-in-production

# ---- Database ----
DATABASE_URL=sqlite:///./job_search_assistant.db
